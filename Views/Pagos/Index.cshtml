@{
    ViewData["Title"] = "Pagar Cita y Confirmación";
    
    var citaId = ViewData["CitaId"] ?? 101;
    var servicio = ViewData["Servicio"]?.ToString() ?? "Corte Clásico de Hombre";
    var montoTotal = Convert.ToDecimal(ViewData["MontoTotal"] ?? 120);
    var evidenciaUrl = ViewData["EvidenciaUrl"]?.ToString();
    var estadoPago = ViewData["EstadoPago"]?.ToString() ?? "Pendiente de Pago";

    // Mensaje automático oficial precargado para el número 9991742323 (sin emojis)
    string mensajeTexto = "¡Hola! Gracias por comunicarte con el Salón de Belleza Nicté Ha.\n\nBuenos días, en un momento más uno de nuestros asesores te atenderá personalmente.\n\nPara agendar tu cita, resolver dudas o realizar algún cambio de horario, te recordamos nuestros horarios de atención:\n\nLunes a Sábado: 9:00 AM – 8:00 PM\n\nDomingos: 10:00 AM – 4:00 PM\n\nQuedamos a tu completa disposición. ¡Te esperamos para consentirte!";
    string mensajeUrlEncoded = Uri.EscapeDataString(mensajeTexto);
    string whatsappUrl = $"https://api.whatsapp.com/send?phone=529991742323&text={mensajeUrlEncoded}";
}

<div class="container mt-4 mb-5">
    
    <!-- Encabezado de la Sección de Pago -->
    <div class="text-center mb-4">
        <h1 class="fw-bold text-success display-5">Finalizar Pago de la Cita</h1>
        <p class="text-muted fs-5">Verifica el desglose del precio de tu corte o servicio y realiza el pago vía transferencia bancaria.</p>
    </div>

    <!-- Alertas de Estado -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <h5 class="alert-heading fw-bold">¡Pago Exitoso!</h5>
            <p class="mb-2">@TempData["SuccessMessage"]</p>
            <hr />
            <div class="d-flex justify-content-between align-items-center">
                <span>¿Deseas enviar la confirmación a nuestro asesor de WhatsApp (9991742323)?</span>
                <a href="@whatsappUrl" target="_blank" class="btn btn-success fw-bold">
                    Enviar mensaje al asesor
                </a>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm mb-4" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        
        <!-- COLUMNA IZQUIERDA: DESGLOSE DE CANTIDAD DE PRECIO E INFORMACIÓN DEL SERVICIO -->
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4 h-100">
                <div class="card-header bg-dark text-white p-3">
                    <h5 class="mb-0 fw-bold">Resumen del Pedido / Cita #@citaId</h5>
                </div>
                <div class="card-body p-4">
                    
                    <h6 class="fw-bold text-primary">Servicio Solicitado:</h6>
                    <p class="fs-5 text-dark fw-semibold mb-3">@servicio</p>
                    
                    <hr />

                    <!-- Desglose detallado de precios -->
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Precio del Servicio:</span>
                        <span class="fw-semibold">$@montoTotal.ToString("0.00") MXN</span>
                    </div>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Impuestos / IVA (Incluido):</span>
                        <span class="fw-semibold">$0.00 MXN</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Cargo por Servicio:</span>
                        <span class="fw-semibold text-success">GRATIS</span>
                    </div>

                    <hr />

                    <!-- CANTIDAD DE PRECIO TOTAL A PAGAR -->
                    <div class="d-flex justify-content-between align-items-center py-2 bg-light rounded-3 px-3">
                        <span class="fs-5 fw-bold text-dark">TOTAL A PAGAR:</span>
                        <span class="fs-2 fw-bold text-success">$@montoTotal.ToString("0.00") MXN</span>
                    </div>

                    <!-- Estado actual del pago -->
                    <div class="mt-4 text-center">
                        <span class="text-muted d-block small mb-1">Estado actual:</span>
                        @if (estadoPago.Contains("Confirmado") || estadoPago.Contains("Completado"))
                        {
                            <span class="badge bg-success fs-6 px-4 py-2 rounded-pill">@estadoPago</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark fs-6 px-4 py-2 rounded-pill">@estadoPago</span>
                        }
                    </div>

                    <div class="mt-4 pt-3 border-top text-center">
                        <a href="@whatsappUrl" target="_blank" class="btn btn-outline-success fw-bold w-100 rounded-3 py-2">
                            Enviar mensaje al asesor
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <!-- COLUMNA DERECHA: SECCIÓN DE PAGAR POR TRANSFERENCIA Y EVIDENCIA -->
        <div class="col-md-7">
            <div class="card shadow-lg border-0 rounded-4">
                
                <div class="card-header bg-primary text-white p-3">
                    <h5 class="mb-0 fw-bold">Pagar por Transferencia Bancaria</h5>
                </div>

                <div class="card-body p-4">
                    
                    <p class="text-muted">Realiza tu pago vía SPEI o Transferencia a la siguiente cuenta oficial y sube la foto de tu comprobante:</p>

                    <!-- CUADRO CON DATOS DE LA CUENTA BANCARIA -->
                    <div class="card bg-light border-0 rounded-3 p-3 mb-4">
                        <div class="row">
                            <div class="col-6 mb-2">
                                <small class="text-muted d-block">Banco Destination:</small>
                                <strong>BBVA México / Banamex</strong>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted d-block">Beneficiario:</small>
                                <strong>Salón Nicté Ha S.A. de C.V.</strong>
                            </div>
                            <div class="col-12 mb-2">
                                <small class="text-muted d-block">CLABE Interbancaria:</small>
                                <span class="font-monospace fs-5 text-primary fw-bold">0129 1000 1234 5678 90</span>
                            </div>
                            <div class="col-12">
                                <small class="text-muted d-block">Concepto de Pago:</small>
                                <span class="fw-bold">CITA-@citaId-@servicio</span>
                            </div>
                        </div>
                    </div>

                    <!-- 
                        FORMULARIO PARA SUBIR LA EVIDENCIA Y CONFIRMAR EL PAGO 
                        Usa enctype="multipart/form-data" para permitir adjuntar la fotografía del comprobante.
                    -->
                    <form action="/Pagos/ConfirmarPago" method="post" enctype="multipart/form-data">
                        
                        <div class="mb-4">
                            <label class="form-label font-weight-bold fw-semibold">
                                Subir imagen de la evidencia de tu transferencia:
                            </label>
                            <input type="file" name="evidenciaPago" class="form-control form-control-lg rounded-3" accept="image/*" required />
                            <small class="text-muted">Archivos permitidos: Fotografía (JPG, PNG) o captura de pantalla de la banca móvil.</small>
                        </div>

                        <!-- VISUALIZACIÓN DE LA EVIDENCIA SUBIDA ABAJO DEL BOTÓN -->
                        @if (!string.IsNullOrEmpty(evidenciaUrl))
                        {
                            <div class="mb-4 text-center p-3 border rounded-3 bg-white">
                                <h6 class="fw-bold text-success mb-2">Evidencia de Transferencia Subida:</h6>
                                <img src="@evidenciaUrl" alt="Comprobante de pago" class="img-fluid rounded-3 shadow-sm" style="max-height: 250px; object-fit: contain;" />
                            </div>
                        }

                        <!-- BOTÓN DE CONFIRMAR PAGO -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg py-3 rounded-3 fw-bold fs-5 shadow">
                                Confirmar Pago y Enviar Comprobante
                            </button>
                        </div>

                    </form>

                </div>

            </div>
        </div>

    </div>

</div>