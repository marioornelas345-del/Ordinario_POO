@using Microsoft.AspNetCore.Http
@{
    var usuarioLogueado = Context.Session.GetString("UsuarioLogueado");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Salón de Belleza Nicté Ha</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">Nicté Ha</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (!string.IsNullOrEmpty(usuarioLogueado))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Servicios" asp-action="Index">Servicios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Citas" asp-action="Index">Citas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Pagos" asp-action="Index">Pagos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Ubicacion" asp-action="Index">Ubicación</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Perfil" asp-action="Index">Mi Perfil (Cliente)</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="Index">Administrador</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <span class="nav-link text-white-50 fst-italic">Sistema Bloqueado - Inicia sesión para navegar</span>
                            </li>
                        }
                    </ul>

                    @if (!string.IsNullOrEmpty(usuarioLogueado))
                    {
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-white small me-2">👤 @usuarioLogueado</span>
                            <a href="/Home/CerrarSesion" class="btn btn-outline-danger btn-sm rounded-pill font-weight-bold">Cerrar Sesión</a>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2">
                            <a href="/Home/Index" class="btn btn-primary btn-sm rounded-pill font-weight-bold px-3">Iniciar Sesión / Google</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4 py-3 bg-light">
        <div class="container text-center">
            &copy; 2026 - Mi Salón de Belleza Nicté Ha (Acceso Protegido UTM)
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>