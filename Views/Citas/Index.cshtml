@{
    // Vista principal del módulo de Citas
    ViewData["Title"] = "Gestión de Citas";
}

<!-- Contenedor principal para la sección de Citas -->
<div class="container mt-5 text-center">
    <div class="card shadow-lg border-0 rounded-4 p-5 mx-auto" style="max-width: 600px;">
        <h2 class="fw-bold text-primary mb-3">Gestión de Citas - Nicté Ha</h2>
        <p class="text-muted fs-5 mb-4">Administra los turnos de tus clientes o agenda una nueva cita en el sistema.</p>
        
        <!-- Botones de acceso a la Agenda y al Formulario de Registro -->
        <div class="d-grid gap-3 col-10 mx-auto">
            <a href="/Citas/AgendaDiaria" class="btn btn-primary btn-lg rounded-3 fw-bold py-3">
                Ver Agenda Diaria de Citas
            </a>
            <a href="/Citas/Registrar" class="btn btn-success btn-lg rounded-3 fw-bold py-3">
                Agendar Nueva Cita
            </a>
        </div>
    </div>
</div>
