@{
    ViewData["Title"] = "Iniciar Sesión - Acceso Requerido";
}

<!-- Contenedor centrado para la pantalla de inicio de sesión / Bloqueo de seguridad -->
<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4">
                
                <!-- Encabezado de Logotipo -->
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary">Salón Nicté Ha</h2>
                    <p class="text-muted small">Inicia sesión con tu cuenta para ingresar al sistema.</p>
                </div>

                <!-- Alertas de Error del Sistema -->
                @if (ViewData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @ViewData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Alertas de Éxito / Advertencias -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- BOTÓN DE SELECCIONAR CUENTA / CONTINUAR CON GOOGLE (Abre Modal de Cuentas) -->
                <div class="d-grid mb-3">
                    <button type="button" class="btn btn-outline-dark rounded-3 py-2 d-flex align-items-center justify-content-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalGoogleAccounts">
                        <!-- Icono SVG oficial de Google -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 48 48">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.28-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24s.92 7.54 2.56 10.78l7.97-6.19z"/>
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                        </svg>
                        <span class="fw-semibold">Continuar con Google</span>
                    </button>
                </div>

                <!-- Separador de opciones -->
                <div class="d-flex align-items-center my-3">
                    <hr class="flex-grow-1" />
                    <span class="px-2 text-muted small">o inicia con tu correo</span>
                    <hr class="flex-grow-1" />
                </div>

                <!-- Formulario estándar de inicio de sesión -->
                <form action="/Home/IniciarSesion" method="post">
                    <!-- Campo de Correo Electrónico -->
                    <div class="form-group mb-3">
                        <label class="form-label font-weight-bold">Correo electrónico</label>
                        <input name="correo" class="form-control rounded-3" type="email" required placeholder="ejemplo@correo.com" />
                    </div>

                    <!-- Campo de Contraseña -->
                    <div class="form-group mb-3">
                        <label class="form-label font-weight-bold">Contraseña</label>
                        <input name="password" class="form-control rounded-3" type="password" required placeholder="********" />
                    </div>

                    <!-- Botón de Ingresar -->
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary py-2 rounded-3 font-weight-bold shadow-sm">Ingresar al Sistema</button>
                    </div>
                </form>

                <!-- SECCIÓN PARA CREAR UNA NUEVA CUENTA -->
                <div class="text-center mt-4 pt-2 border-top">
                    <p class="mb-0 text-muted">¿Aún no tienes una cuenta?</p>
                    <a href="/Home/CrearCuenta" class="btn btn-link text-decoration-none fw-bold">Crear una cuenta nueva</a>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- =========================================================================================
     MODAL SELECCIONADOR DE CUENTAS DE GOOGLE (GOOGLE OAUTH SELECTOR API)
     ========================================================================================= -->
<div class="modal fade" id="modalGoogleAccounts" tabindex="-1" aria-labelledby="modalGoogleAccountsLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            
            <div class="modal-header border-bottom-0 pb-0 text-center d-block position-relative">
                <!-- Icono Google Superior -->
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 48 48" class="mb-2">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.28-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24s.92 7.54 2.56 10.78l7.97-6.19z"/>
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
                <h5 class="modal-title fw-bold text-dark" id="modalGoogleAccountsLabel">Selecciona una cuenta de Google</h5>
                <p class="text-muted small mb-0">para continuar en <strong>Salón de Belleza Nicté Ha</strong></p>
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                
                <div class="list-group list-group-flush rounded-3 border">
                    
                    <!-- OPCIÓN 1: CUENTA ADMIN NICTE HA -->
                    <a href="/Home/IniciarSesionGoogleAccount?correo=NICTEha@gamil.com" class="list-group-item list-group-item-action p-3 d-flex align-items-center gap-3">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 42px; height: 42px; font-size: 1.1rem;">
                            N
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-0 fw-bold text-dark">Nicté Ha Salón (Admin)</h6>
                            <small class="text-muted">NICTEha@gamil.com</small>
                        </div>
                    </a>

                    <!-- OPCIÓN 2: CUENTA CLIENTE MARIO ISAAC -->
                    <a href="/Home/IniciarSesionGoogleAccount?correo=marioornelas345@gmail.com" class="list-group-item list-group-item-action p-3 d-flex align-items-center gap-3">
                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 42px; height: 42px; font-size: 1.1rem;">
                            M
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-0 fw-bold text-dark">Mario Isaac Ornelas</h6>
                            <small class="text-muted">marioornelas345@gmail.com</small>
                        </div>
                    </a>

                    <!-- OPCIÓN 3: OTRA CUENTA DE GOOGLE -->
                    <a href="/Home/IniciarSesionGoogleAccount?correo=usuario.nuevo@gmail.com" class="list-group-item list-group-item-action p-3 d-flex align-items-center gap-3">
                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 42px; height: 42px; font-size: 1.1rem;">
                            +
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-0 fw-bold text-dark">Usar otra cuenta de Google</h6>
                            <small class="text-muted">Inicia sesión con un correo diferente</small>
                        </div>
                    </a>

                </div>

                <div class="text-center mt-4">
                    <small class="text-muted">Al continuar, Google compartirá tu nombre, correo y foto de perfil con Salón Nicté Ha.</small>
                </div>

            </div>

        </div>
    </div>
</div>