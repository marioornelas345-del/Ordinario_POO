@{
    // Título de la página que se inserta en la plantilla principal _Layout.cshtml
    ViewData["Title"] = "Iniciar Sesión";
}

<!-- Contenedor centrado para el formulario de inicio de sesión -->
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4">
                
                <!-- Encabezado con el logotipo y nombre del salón -->
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary">Salón Nicté Ha</h2>
                    <p class="text-muted">Bienvenido de nuevo. Inicia sesión en tu cuenta.</p>
                </div>

                <!-- Alerta para mensajes de error al iniciar sesión -->
                @if (ViewData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @ViewData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Alerta para mensajes de éxito (ej. al crear cuenta o vincular Google) -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- BOTÓN DE EMPAREJAR / CONTINUAR CON GOOGLE -->
                <div class="d-grid mb-3">
                    <a href="/Home/IniciarSesionGoogle" class="btn btn-outline-dark rounded-3 py-2 d-flex align-items-center justify-content-center gap-2 shadow-sm">
                        <!-- Icono SVG oficial de Google -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 48 48">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.28-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24s.92 7.54 2.56 10.78l7.97-6.19z"/>
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                        </svg>
                        <span class="fw-semibold">Emparejar / Continuar con Google</span>
                    </a>
                </div>

                <!-- Separador de opciones -->
                <div class="d-flex align-items-center my-3">
                    <hr class="flex-grow-1" />
                    <span class="px-2 text-muted small">o inicia con tu correo</span>
                    <hr class="flex-grow-1" />
                </div>

                <!-- Formulario estándar de inicio de sesión -->
                <form action="/Home/IniciarSesion" method="post">
                    <!-- Campo de Correo Electrónico -->
                    <div class="form-group mb-3">
                        <label class="form-label font-weight-bold">Correo electrónico</label>
                        <input name="correo" class="form-control rounded-3" type="email" required placeholder="ejemplo@correo.com" />
                    </div>

                    <!-- Campo de Contraseña -->
                    <div class="form-group mb-3">
                        <label class="form-label font-weight-bold">Contraseña</label>
                        <input name="password" class="form-control rounded-3" type="password" required placeholder="********" />
                    </div>

                    <!-- Botón de Ingresar -->
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary py-2 rounded-3 font-weight-bold">Ingresar al Sistema</button>
                    </div>
                </form>

                <!-- SECCIÓN PARA CREAR UNA NUEVA CUENTA -->
                <div class="text-center mt-4 pt-2 border-top">
                    <p class="mb-0 text-muted">¿Aún no tienes una cuenta?</p>
                    <a href="/Home/CrearCuenta" class="btn btn-link text-decoration-none fw-bold">Crear una cuenta nueva</a>
                </div>

            </div>
        </div>
    </div>
</div>